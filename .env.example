# Copy to .env (never commit .env).
MSSQL_SA_PASSWORD=Change_Me_2026!
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@example.ae
ADMIN_PASSWORD=Change_Me_2026!
ADMIN_NAME=Administrator
WEB_PORT=8080
# Host port for SQL Server (only for connecting tools from your machine; the API uses the internal network).
# Change it if 1433 is taken, e.g. by a SQL Server installed on Windows.
MSSQL_PORT=1433
