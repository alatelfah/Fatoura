  "components": {
    "schemas": {
      "AuthResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "user",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        }
      },
      "ClientDto": {
        "required": [
          "id",
          "name",
          "phone",
